fn get_index(x: int, y: int) -> int {
    return y * 64 + x;
}

fn count_neighbors(grid: int, x: int, y: int) -> int {
    let count = 0;
    
    // Check all 8 neighbors using modulus to wrap around the grid (toroidal)
    let dy = -1;
    loop {
        if dy > 1 { break; }
        
        let dx = -1;
        loop {
            if dx > 1 { break; }
            
            if !(dx == 0 && dy == 0) {
                let nx = (x + dx + 64) % 64;
                let ny = (y + dy + 64) % 64;
                
                let idx = get_index(nx, ny);
                if grid[idx] == 1 {
                    count = count + 1;
                }
            }
            
            dx = dx + 1;
        };
        
        dy = dy + 1;
    };
    
    return count;
}

fn main() {
    print("Starting Game of Life: " + "Ennuyeux " + "Edition!");

    let current = arr(4096);
    let next = arr(4096);
    
    // Initialize array memory to 0
    let i = 0;
    loop {
        if i >= 4096 { break; }
        current[i] = 0;
        next[i] = 0;
        i = i + 1;
    };

    // Initialize Glider
    current[get_index(2, 1)] = 1;
    current[get_index(3, 2)] = 1;
    current[get_index(1, 3)] = 1;
    current[get_index(2, 3)] = 1;
    current[get_index(3, 3)] = 1;

    // Add a Blinker
    current[get_index(10, 10)] = 1;
    current[get_index(10, 11)] = 1;
    current[get_index(10, 12)] = 1;

    // Add a Toad
    current[get_index(20, 20)] = 1;
    current[get_index(21, 20)] = 1;
    current[get_index(22, 20)] = 1;
    current[get_index(19, 21)] = 1;
    current[get_index(20, 21)] = 1;
    current[get_index(21, 21)] = 1;

    // Draw initial state
    i = 0;
    loop {
        if i >= 4096 { break; }
        if current[i] == 1 {
            let x = i % 64;
            let y = i / 64;
            pixel(x, y, 1);
        }
        i = i + 1;
    };

    let generation = 0;
    loop {
        // Just run for 200 generations for now so it doesn't loop infinitely in testing
        if generation > 200 { break; }
        
        let y = 0;
        loop {
            if y >= 64 { break; }
            let x = 0;
            loop {
                if x >= 64 { break; }
                
                let idx = get_index(x, y);
                let state = current[idx];
                let neighbors = count_neighbors(current, x, y);
                
                if state == 1 && (neighbors == 2 || neighbors == 3) {
                    next[idx] = 1;
                } else {
                    if state == 0 && neighbors == 3 {
                        next[idx] = 1;
                    } else {
                        next[idx] = 0;
                    }
                }
                
                x = x + 1;
            };
            y = y + 1;
        };

        // Swap buffers and draw
        let j = 0;
        loop {
            if j >= 4096 { break; }
            let s = next[j];
            if current[j] != s {
                let x = j % 64;
                let y = j / 64;
                pixel(x, y, s);
            }
            current[j] = s;
            j = j + 1;
        };
        
        generation = generation + 1;
        if generation % 10 == 0 {
            print("Generation: " + generation);
        }
    };
    
    print("Simulation complete.");
}
