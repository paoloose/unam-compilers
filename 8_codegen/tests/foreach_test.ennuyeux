fn main() {
    let data = arr(5);
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    data[3] = 40;
    data[4] = 50;

    // Iterate over the array using foreach
    let total = 0;
    for item in data {
        print(item);
        total = total + item;
    };
    print("Total:");
    print(total);
}
